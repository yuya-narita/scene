                "plain",
                "moon",
                "star",
                "coffee",
                "cat",
                "book",
                "leaf",
                "night"
              ]
            }
          }
        },
        "webMail": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mailId": {
              "type": "string"
            },
            "folder": {
              "type": "string",
              "enum": [
                "inbox",
                "sent",
                "draft",
                "spam"
              ]
            },
            "senderName": {
              "type": "string"
            },
            "senderAddress": {
              "type": "string"
            },
            "to": {
              "type": "string"
            },
            "cc": {
              "type": "string"
            },
            "subject": {
              "type": "string"
            },
            "icon": {
              "type": "string"
            },
            "unread": {
              "type": "boolean"
            },
            "starred": {
              "type": "boolean"
            },
            "deleted": {
              "type": "boolean",
              "description": "Legacy v0.1 field. Ignored and removed by Studio v0.2."
            },
            "_editorFileName": {
              "type": "string"
            },
            "_editorManaged": {
              "type": "boolean"
            },
            "iconPreset": {
              "type": "string",
              "enum": [
                "",
