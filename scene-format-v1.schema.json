            "subtitle": {
              "$ref": "#/$defs/style"
            },
            "author": {
              "$ref": "#/$defs/style"
            },
            "episode": {
              "$ref": "#/$defs/style"
            },
            "episodeTitle": {
              "$ref": "#/$defs/style"
            }
          },
          "additionalProperties": true
        },
        "text": {
          "type": "object",
          "description": "Deprecated legacy cover-only text override. Studio v13+ uses canonical work metadata plus cover.visibility.",
          "properties": {
            "title": {
              "type": "string"
            },
            "icon": {
              "type": "string"
            },
            "_editorFileName": {
              "type": "string"
            },
            "_editorManaged": {
              "type": "boolean"
            },
            "iconPreset": {
              "type": "string",
              "enum": [
                "",
                "m01",
                "m02",
                "m03",
                "m04",
                "m05",
                "m06",
                "f01",
                "f02",
                "f03",
                "f04",
                "f05",
                "f06",
                "a01",
                "a02",
                "a03",
                "a04",
                "a05",
                "a06",
                "o01",
                "o02",
                "o03",
                "o04",
                "o05",
                "o06"
              ]
            },
            "subtitle": {
              "type": "string"
            },
            "author": {
              "type": "string"
            },
            "episode": {
              "type": "string"
            },
            "episodeTitle": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "visibility": {
          "type": "object",
          "description": "Controls whether canonical work metadata is rendered on the cover. It does not change title/author/episode metadata.",
          "properties": {
            "title": {
              "type": "boolean"
            },
            "subtitle": {
              "type": "boolean"
            },
            "author": {
              "type": "boolean"
            },
            "episode": {
              "type": "boolean"
            },
            "episodeTitle": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "endingLink": {
      "type": "object",
      "properties": {
        "position": {
          "enum": [
            "left",
            "right"
          ]
        },
        "kicker": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "ending": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "description": "Author-entered LF line breaks are significant and must be preserved by Players."
        },
        "coverButton": {
          "type": "object",
          "properties": {
            "kicker": {
              "type": "string"
            },
            "label": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/endingLink"
          },
          "maxItems": 2
        },
        "audio": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/audioCommand"
          },
          "description": "Optional ending-page audio commands. Studio currently authors one-shot SE here."
        },
        "fontFamily": {
          "enum": [
            "serif",
            "sans",
            "mono"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "description": "Current Scene Studio / Player shared v1.0 contract. Existing v1.0 .scene files remain compatible."
}
