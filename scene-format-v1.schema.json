{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scene.studio/schema/scene-format-v1.schema.json",
  "title": "Scene Format v1.0 — Studio Contract",
  "type": "object",
  "required": [
    "format",
    "version",
    "language",
    "title",
    "author",
    "theme",
    "scenes"
  ],
  "properties": {
    "format": {
      "const": "scene-format"
    },
    "version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "workId": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "pattern": "^(?:mul|und|[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*)$"
    },
    "title": {
      "type": "string",
      "description": "Author-entered LF line breaks are significant and must be preserved by cover renderers; text without LF may wrap responsively."
    },
    "author": {
      "type": "string"
    },
    "theme": {
      "enum": [
        "light",
        "dark",
        "cinema"
      ]
    },
    "preset": {
      "type": "string",
      "minLength": 1
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scene"
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    },
    "player": {
      "$ref": "#/$defs/player"
    },
    "appearance": {
      "type": "object",
      "properties": {
        "cinemaTone": {
          "enum": [
            "dark",
            "light"
          ]
        },
        "typography": {
          "type": "object",
          "properties": {
            "fontFamily": {
              "enum": [
                "serif",
                "sans",
                "mono"
              ]
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
      },
      "uniqueItems": true
    },
    "direction": {
      "enum": [
        "auto",
        "ltr",
        "rtl"
      ]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "subtitle": {
          "type": "string"
        },
        "seriesTitle": {
          "type": "string"
        },
        "seriesId": {
          "type": "string",
          "pattern": "^series_[a-f0-9]{32}$"
        },
        "episode": {
          "type": "string"
        },
        "episodeNumber": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9999
        },
        "episodeTitle": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "cover": {
      "$ref": "#/$defs/cover"
    },
    "ending": {
      "$ref": "#/$defs/ending"
    },
    "sharing": {
      "type": "object",
      "properties": {
        "relay": {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "type": "string"
            },
            "enabled": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        },
        "ownCopy": {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "type": "string"
            },
            "enabled": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "scene": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "text",
            "dialogue",
            "sound"
          ]
        },
        "text": {
          "type": "string",
          "description": "Primary Scene text. Author-entered LF line breaks are significant and must be preserved."
        },
        "subText": {
          "type": "string",
          "description": "Secondary Scene text. Author-entered LF line breaks are significant and must be preserved."
        },
        "pause": {
          "type": "number",
          "minimum": 0
        },
        "cueAt": {
          "type": "number",
          "minimum": 0,
          "description": "Absolute Scene appearance cue in milliseconds from the Scene 1/audio zero point. New AUTO REC writes this alongside pause; legacy players may ignore it."
        },
        "presentation": {
          "$ref": "#/$defs/presentation"
        },
        "audio": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/audioCommand"
          }
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        },
        "language": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
        },
        "direction": {
          "enum": [
            "auto",
            "ltr",
            "rtl"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "text",
                  "dialogue"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "text"
            ]
          }
        }
      ],
      "additionalProperties": true
    },
    "style": {
      "type": "object",
      "properties": {
        "color": {
          "type": "string"
        },
        "size": {
          "oneOf": [
            {
              "enum": [
                "auto",
                "small",
                "normal",
                "large",
                "xl"
              ]
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            }
          ]
        },
        "wrap": {
          "enum": [
            "auto",
            "nowrap"
          ]
        },
        "fontFamily": {
          "enum": [
            "inherit",
            "serif",
            "sans",
            "mono"
          ]
        },
        "shadow": {
          "enum": [
            "none",
            "soft",
            "strong"
          ]
        },
        "lineHeight": {
          "type": "number",
          "minimum": 1,
          "maximum": 3
        },
        "letterSpacing": {
          "type": "number",
          "minimum": -0.2,
          "maximum": 0.5
        },
        "sideMargin": {
          "type": "number",
          "minimum": 0,
          "maximum": 40
        },
        "opacity": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 1
        },
        "align": {
          "enum": [
            "auto",
            "left",
            "center",
            "right"
          ]
        },
        "writingMode": {
          "enum": [
            "horizontal-tb",
            "vertical-rl"
          ]
        },
        "fontWeight": {
          "type": "number",
          "minimum": 100,
          "maximum": 900
        },
        "position": {
          "type": "object",
          "properties": {
            "preset": {
              "enum": [
                "auto",
                "top-left",
                "top",
                "top-right",
                "left",
                "center",
                "right",
                "bottom-left",
                "bottom",
                "bottom-right",
                "custom"
              ]
            },
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "pc": {
              "type": "object",
              "description": "Optional wide-PC-only text/frame position. Phone and tablet use the common parent position.",
              "properties": {
                "preset": {
                  "enum": [
                    "auto",
                    "top-left",
                    "top",
                    "top-right",
                    "left",
                    "center",
                    "right",
                    "bottom-left",
                    "bottom",
                    "bottom-right",
                    "custom"
                  ]
                },
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "presentation": {
      "type": "object",
      "properties": {
        "display": {
          "enum": [
            "stack",
            "solo",
            "overlay"
          ]
        },
        "flow": {
          "enum": [
            "vertical",
            "horizontal"
          ]
        },
        "view": {
          "enum": [
            "world",
            "console",
            "system",
            "warning",
            "void",
            "chat",
            "web-board",
            "web-comment",
            "web-review",
            "web-qa",
            "web-sns",
            "web-mail",
            "web-notification"
          ]
        },
        "effect": {
          "enum": [
            "none",
            "blur",
            "fade",
            "loud",
            "pop",
            "pulse",
            "shake",
            "slow",
            "tilt",
            "whisper",
            "slam",
            "burst",
            "glitchHit",
            "glitchHitRight",
            "rush",
            "auto",
            "fadeRise",
            "softRise",
            "whisperIn",
            "emphasis",
            "settle"
          ]
        },
        "text": {
          "$ref": "#/$defs/style"
        },
        "frame": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "handdrawn-voice",
                "handdrawn-narration",
                "handdrawn-rounded",
                "handdrawn-double",
                "handdrawn-dashed",
                "handdrawn-dark",
                "handdrawn-panel"
              ]
            },
            "position": {
              "type": "object",
              "properties": {
                "preset": {
                  "enum": [
                    "auto",
                    "top-left",
                    "top",
                    "top-right",
                    "left",
                    "center",
                    "right",
                    "bottom-left",
                    "bottom",
                    "bottom-right",
                    "custom"
                  ]
                },
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": true
        },
        "subText": {
          "$ref": "#/$defs/style"
        },
        "typing": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "speed": {
              "type": "number",
              "minimum": 0
            },
            "cursor": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        },
        "disappear": {
          "type": "object",
          "properties": {
            "after": {
              "type": "number",
              "minimum": 0
            },
            "fade": {
              "type": "number",
              "minimum": 0
            },
            "motion": {
              "enum": [
                "stay",
                "up",
                "shatter",
                "explode"
              ]
            },
            "scope": {
              "enum": [
                "scene",
                "visible"
              ]
            }
          },
          "additionalProperties": true
        },
        "webBoard": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "number": {
              "type": [
                "integer",
                "string"
              ]
            },
            "name": {
              "type": "string"
            },
            "date": {
              "type": "string"
            },
            "userId": {
              "type": "string"
            },
            "email": {
              "type": "string"
            },
            "replyTo": {
              "type": "string"
            },
            "threadId": {
              "type": "string"
            },
            "replyThreadId": {
              "type": "string"
            }
          }
        },
        "messageState": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "normal",
                "deleted"
              ]
            },
            "delay": {
              "type": "number",
              "minimum": 0,
              "maximum": 300
            }
          }
        },
        "logTime": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "none",
                "work",
                "edit",
                "reader",
                "relative"
              ]
            },
            "workTime": {
              "type": "string"
            },
            "editedAt": {
              "type": "string"
            },
            "relativeText": {
              "type": "string"
            }
          }
        },
        "background": {
          "$ref": "#/$defs/background"
        },
        "effectTiming": {
          "type": "object",
          "properties": {
            "duration": {
              "type": "number",
              "minimum": 0
            },
            "delay": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": true
        },
        "entryMotion": {
          "enum": [
            "flow",
            "still"
          ]
        },
        "webComment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "commentId": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "icon": {
              "type": "string"
            },
            "iconText": {
              "type": "string"
            },
            "likes": {
              "type": [
                "integer",
                "number"
              ],
              "minimum": 0
            },
            "replyTo": {
              "type": "string"
            },
            "_editorFileName": {
              "type": "string"
            },
            "_editorManaged": {
              "type": "boolean"
            },
            "reaction": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": [
                    "fixed",
                    "random",
                    "dynamic"
                  ]
                },
                "value": {
                  "type": [
                    "integer",
                    "number"
                  ],
                  "minimum": 0
                },
                "min": {
                  "type": [
                    "integer",
                    "number"
                  ],
                  "minimum": 0
                },
                "max": {
                  "type": [
                    "integer",
                    "number"
                  ],
                  "minimum": 0
                },
                "start": {
                  "type": [
                    "integer",
                    "number"
                  ],
                  "minimum": 0
                },
                "end": {
                  "type": [
                    "integer",
                    "number"
                  ],
                  "minimum": 0
                },
                "delay": {
                  "type": "number",
                  "minimum": 0
                },
                "duration": {
                  "type": "number",
                  "minimum": 0
                },
                "curve": {
                  "type": "string",
                  "enum": [
                    "linear",
                    "ease",
                    "burst",
                    "wave",
                    "initial",
                    "fire",
                    "steps",
                    "irregular",
                    "decay"
                  ]
                }
              }
            },
            "role": {
              "type": "string",
              "enum": [
                "extra",
                "manual"
              ]
            },
            "iconPreset": {
              "type": "string",
              "enum": [
                "",
                "m01",
                "m02",
                "m03",
                "m04",
                "m05",
                "m06",
                "f01",
                "f02",
                "f03",
                "f04",
                "f05",
                "f06",
                "a01",
                "a02",
                "a03",
                "a04",
                "a05",
                "a06",
                "o01",
                "o02",
                "o03",
                "o04",
                "o05",
                "o06",
                "plain",
                "moon",
                "star",
                "coffee",
                "cat",
                "book",
                "leaf",
                "night"
              ]
            }
          }
        },
        "flowComments": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "density": {
              "type": "string",
              "enum": [
                "few",
                "normal",
                "many",
                "danmaku"
              ]
            },
            "comments": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "manual",
                      "extra"
                    ]
                  },
                  "delay": {
                    "type": "number",
                    "minimum": 0
                  },
                  "lane": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "speed": {
                    "type": "number",
                    "minimum": 0
                  },
                  "size": {
                    "type": "number",
                    "minimum": 8,
                    "maximum": 72
                  },
                  "color": {
                    "type": "string"
                  }
                },
                "required": [
                  "text"
                ]
              }
            },
            "context": {
              "type": "string",
              "enum": [
                "normal",
                "excited",
                "laugh",
                "surprise",
                "horror",
                "emotion",
                "flame",
                "tsukkomi",
                "ending"
              ]
            }
          }
        },
        "webReview": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reviewId": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "icon": {
              "type": "string"
            },
            "rating": {
              "type": [
                "integer",
                "number"
              ],
              "minimum": 1,
              "maximum": 5
            },
            "verified": {
              "type": "boolean"
            },
            "role": {
              "type": "string",
              "enum": [
                "extra",
                "manual"
              ]
            },
            "_editorFileName": {
              "type": "string"
            },
            "_editorManaged": {
              "type": "boolean"
            },
            "iconPreset": {
              "type": "string",
              "enum": [
                "",
                "m01",
                "m02",
                "m03",
                "m04",
                "m05",
                "m06",
                "f01",
                "f02",
                "f03",
                "f04",
                "f05",
                "f06",
                "a01",
                "a02",
                "a03",
                "a04",
                "a05",
                "a06",
                "o01",
                "o02",
                "o03",
                "o04",
                "o05",
                "o06",
                "plain",
                "moon",
                "star",
                "coffee",
                "cat",
                "book",
                "leaf",
                "night"
              ]
            }
          }
        },
        "webSNS": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "postId": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "handle": {
              "type": "string"
            },
            "platform": {
              "type": "string"
            },
            "icon": {
              "type": "string"
            },
            "profileUrl": {
              "type": "string"
            },
            "likes": {
              "type": [
                "integer",
                "number"
              ],
              "minimum": 0
            },
            "reposts": {
              "type": [
                "integer",
                "number"
              ],
              "minimum": 0
            },
            "replies": {
              "type": [
                "integer",
                "number"
              ],
              "minimum": 0
            },
            "role": {
              "type": "string",
              "enum": [
                "extra",
                "manual"
              ]
            },
            "deleted": {
              "type": "boolean"
            },
            "_editorFileName": {
              "type": "string"
            },
            "_editorManaged": {
              "type": "boolean"
            },
            "iconPreset": {
              "type": "string",
              "enum": [
                "",
                "m01",
                "m02",
                "m03",
                "m04",
                "m05",
                "m06",
                "f01",
                "f02",
                "f03",
                "f04",
                "f05",
                "f06",
                "a01",
