                "a04",
                "a05",
                "a06",
                "o01",
                "o02",
                "o03",
                "o04",
                "o05",
                "o06",
                "plain",
                "moon",
                "star",
                "coffee",
                "cat",
                "book",
                "leaf",
                "night"
              ]
            },
            "attachmentName": {
              "type": "string"
            }
          }
        },
        "webNotification": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "notificationId": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "social",
                "mail",
                "system",
                "message",
                "other"
              ]
            },
            "source": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "icon": {
              "type": "string"
            },
            "_editorFileName": {
              "type": "string"
            },
            "_editorManaged": {
              "type": "boolean"
            },
            "iconPreset": {
              "type": "string",
              "enum": [
                "",
                "m01",
                "m02",
                "m03",
