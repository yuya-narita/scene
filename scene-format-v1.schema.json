              ]
            }
          }
        }
      },
      "additionalProperties": true
    },
    "background": {
      "type": "object",
      "properties": {
        "src": {
          "type": "string"
        },
        "transition": {
          "enum": [
            "fade",
            "cut",
            "flash",
            "glitch"
          ]
        },
        "exit": {
          "description": "Optional outgoing treatment applied to the previous background when entering this Scene.",
          "enum": [
            "auto",
            "fade",
            "dark",
            "light",
            "blur",
            "zoomOut",
            "zoomIn",
            "afterimage"
          ]
        },
        "dim": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "blur": {
          "type": "number",
          "minimum": 0
        },
        "fit": {
          "enum": [
            "cover",
            "contain"
          ]
        },
        "position": {
          "type": "string"
        },
        "positions": {
          "type": "object",
          "description": "Optional device-specific cover crop positions. Legacy position remains the phone/common fallback.",
          "properties": {
            "phone": {
              "type": "string"
            },
            "tablet": {
              "type": "string"
            },
            "pc": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "reveal": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "none",
                "still",
                "intro",
                "memory",
                "ghost",
                "flash"
              ]
            },
            "duration": {
              "type": "number",
              "minimum": 0
            },
            "hold": {
              "type": "number",
              "minimum": 0
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": true
        },
        "motion": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "none",
                "parallax",
                "breath",
                "slowZoom",
                "zoomOut",
                "panLeft",
                "panRight",
                "panUp",
                "panDown",
                "panUpLeft",
                "panUpRight",
                "panDownLeft",
                "panDownRight"
              ]
            },
            "duration": {
              "type": "number",
              "minimum": 0
            },
            "scaleFrom": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "scaleTo": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "pan": {
              "type": "number"
            },
            "continuity": {
              "description": "carry keeps the motion phase continuous across a background swap when the motion type matches.",
              "enum": [
                "restart",
                "carry"
              ]
            }
          },
          "additionalProperties": true
        },
        "textures": {
          "type": "object",
          "properties": {
            "blur": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "grain": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "scanline": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "glitch": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "vignette": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "monochrome": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": true
        },
        "tone": {
          "enum": [
            "dark",
            "light"
          ]
        },
        "transitionDuration": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        }
      },
      "additionalProperties": true
    },
    "audioCommand": {
      "type": "object",
      "required": [
        "channel",
        "action"
      ],
      "properties": {
        "channel": {
          "enum": [
            "bgm",
            "ambient",
            "oneshot"
          ]
        },
        "action": {
          "enum": [
            "start",
            "stop",
            "volume",
            "duck",
            "play"
          ]
        },
        "role": {
          "enum": [
            "voice",
            "se",
            "other"
          ]
        },
        "src": {
          "type": "string"
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "loop": {
          "type": "boolean"
        },
        "fadeIn": {
          "type": "number",
          "minimum": 0
        },
        "fadeOut": {
          "type": "number",
          "minimum": 0
        },
        "fade": {
          "type": "number",
          "minimum": 0
        },
        "hold": {
          "type": "number",
          "minimum": 0
        },
        "stopAfter": {
          "type": "number",
          "minimum": 0
        },
        "startAt": {
          "type": "number",
          "minimum": 0
        },
        "stopAt": {
          "type": "number",
          "minimum": 0
        },
        "restart": {
          "type": "boolean"
        },
        "_editorFileName": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "player": {
      "type": "object",
      "properties": {
        "navigation": {
          "type": "object",
          "properties": {
            "allowPrevious": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        },
        "resonance": {
          "type": "object",
          "description": "Optional author/reader pacing comparison. Disabled by default. AUTO REC scene.pause values remain the author reference timing.",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "authorOptIn": {
              "type": "boolean",
              "description": "True only after the author explicitly enables Resonance in Studio. Missing means OFF for backward compatibility."
            },
            "mode": {
              "enum": [
                "absolute",
                "interval-v2",
                "standard-v3"
              ]
            },
            "authorOptInVersion": {
              "type": "integer",
              "description": "Current explicit opt-in marker. Resonance is enabled only when this is 2."
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "coverLogo": {
      "type": "object",
      "properties": {
        "src": {
          "type": "string"
        },
        "_editorFileName": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "cover": {
      "type": "object",
      "properties": {
        "startMode": {
          "enum": ["scene", "comic"],
          "default": "scene",
          "description": "How START behaves: begin Scene playback or open the first Scene image viewer."
        },
        "src": {
          "type": "string"
        },
        "fit": {
          "enum": [
            "cover",
            "contain"
          ]
        },
        "position": {
          "type": "string"
        },
        "logo": {
          "$ref": "#/$defs/coverLogo"
        },
        "fontFamily": {
          "enum": [
            "serif",
            "sans",
            "mono"
          ]
        },
        "styles": {
          "type": "object",
          "properties": {
            "title": {
              "$ref": "#/$defs/style"
