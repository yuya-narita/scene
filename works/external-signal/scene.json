{
  "format": "scene-format",
  "version": "1.0",
  "title": "EXTERNAL SIGNAL",
  "author": "API / Embed Test",
  "language": "mul",
  "languages": ["ja", "en"],
  "direction": "auto",
  "theme": "cinema",
